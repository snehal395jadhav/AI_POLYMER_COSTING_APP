# Copy this file to `.env` and customize before first `docker compose up`.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
COSTING_SECRET=replace-with-a-64-char-random-hex-string

# OpenRouter powers the on-demand AI Costing Copilot.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_REQUESTS_PER_HOUR=20

# Seed a fictional RFQ pipeline on first start. Set to 0 for production.
COSTING_DEMO_DATA=1
